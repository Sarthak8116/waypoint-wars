# ---- Waypoint Wars environment template ----
#
# Copy to .env.local and fill in. NEVER put a real value in THIS file — it is
# deliberately whitelisted in .gitignore (`!.env.example`) so the template is
# committed, which means anything written here is published.
#
# Every key is optional. Without one, that integration runs as a clearly
# labelled mock and the app still works. GET /health reports which are live.

# Photo verification. Without it: a deterministic, labelled mock.
GEMINI_API_KEY=

# Override the model if latency matters. Measured, vision + structured output:
#   gemini-3.6-flash          ~4.6s  (default, better landmark matching)
#   gemini-flash-lite-latest  ~0.9s  (5x faster, likely weaker)
GEMINI_MODEL_ID=

# Persistence. Without it: file-backed storage under .data/, which survives
# a restart. The Mongo adapter is real code but has never connected.
MONGODB_URI=
MONGODB_DB=waypoint_wars

# Optional narration. Without it: audio controls are hidden.
ELEVENLABS_API_KEY=

# Optional map tiles. Without it: free OSM raster tiles.
MAPTILER_KEY=

# Optional historical source retrieval. Mocked when absent.
QUERIT_API_KEY=

# Local wiring
NEXT_PUBLIC_MULTIPLAYER_URL=ws://localhost:2567
NEXT_PUBLIC_API_URL=http://localhost:2567
PORT=2567
