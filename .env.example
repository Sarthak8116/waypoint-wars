# ---- Waypoint Wars environment template ----
# Copy to .env.local and fill in. NEVER commit .env.local

# REQUIRED for real photo verification. Without it the app runs a labeled mock.
GEMINI_API_KEY=

# Optional. Without it the server uses an in-memory store (resets on restart).
MONGODB_URI=
MONGODB_DB=waypoint_wars

# Optional. Without it, narration is disabled (game remains fully playable).
ELEVENLABS_API_KEY=

# Optional. Without it, MapLibre uses free OSM raster tiles.
MAPTILER_KEY=

# Optional historical-source retrieval. Mocked when absent.
QUERIT_API_KEY=

# Local wiring
NEXT_PUBLIC_MULTIPLAYER_URL=ws://localhost:2567
NEXT_PUBLIC_API_URL=http://localhost:2567
PORT=2567
